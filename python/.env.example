# Required for llm mode (xAI Grok via Stagehand BYO LLM callback).
# Lean mode does not need this key or Chrome.
XAI_API_KEY=
# Optional: run in a Browserbase cloud browser instead of local Chrome (llm mode)
# BROWSERBASE_API_KEY=
# Optional overrides
# STAGEHAND_MODEL=grok-4-fast-reasoning
# SCRAPE_MODE=lean
# HEADLESS=false
